---
layout: null
permalink: /wiki_index.json
---
[
  {% assign wiki_pages = site.pages | where_exp: "item", "item.path contains 'wiki/'" %}
  {% for p in wiki_pages %}
    {
      "title": {{ p.title | jsonify }},
      "url": {{ p.url | jsonify }},
      "path": {{ p.path | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
